{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 6,

  "modules-left": ["custom/logo", "sway/workspaces", "wlr/taskbar"],
  "modules-center": ["clock"],
  "modules-right": [
    "group/expand",
    "custom/updates",
    "custom/cam",
    "custom/mic",
    "custom/audio",
    "network",
    "custom/layout",
    "custom/notification_center"
  ],

  "sway/workspaces": {
    "on-click": "activate",
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": []
    }
  },

  "wlr/taskbar": {
    "format": "{name}",
    "on-click": "activate",
    "tooltip-format": "TEST {app_id} | {name} | {title}",
    "rewrite": {
      "LibreWolf": "\uf269",
      "librewolf": "\uf269",
      "Firefox": "\uf269",
      "Google Chrome": "\uf268",
      "Chromium": "\uf268",

      "Settings": "\uf798",
      "Gnome-control-center": "\uf798",
      "gnome-control-center": "\uf798",

      "Kitty": "\uf489",
      "Konsole": "\uf489",
      "Warp": "\uf489",
      "Alacritty": "\uf489",
      "GNOME Terminal": "\uf489",
      "org\\.gnome\\.Terminal": "\uf489",
      "Foot": "\uf489",
      "WezTerm": "\uf489",
      "XTerm": "\uf489",

      "Spotify": "\uf1bc",
      "Thunderbird": "\uf370",
      "LocalSend": "\udb81\udf1b",
      "VLC media player": "\uf144",
      "VLC": "\uf144",
      "Rhythmbox": "\uf001",
      "MPV": "\uf144",
      "Celluloid": "\uf144",
      "Video\\s*Player": "\uf144",
      "Music": "\uf001",

      "LibreOffice.*": "\uf15c",
      "OpenOffice.*": "\uf15c",
      "Boxes": "\ued75",
      "Files": "\uf07b",
      "Nautilus": "\uf07b",
      "Dolphin": "\uf07b",
      "Thunar": "\uf07b",
      "Nemo": "\uf07b",
      "Caja": "\uf07b",
      "PCManFM": "\uf07b",
      "pcmanfm-qt": "\uf07b",
      "Krusader": "\uf07b",

      ".*Code": "\udb82\ude1e",
      "Discover": "\uf1f2",
      ".*KDE": "\uf013"
    }
  },

  "clock": {
    "format": "{:%H:%M  %d/%m/%Y}",
    "format-alt": "{:L%H:%M:%S - %A %d %B %Y (sem.%V)}",
    "tooltip": false
  },

  "custom/audio": {
    "exec": "~/.config/scripts/audio_status.sh",
    "interval": 2,
    "on-click": "~/.config/scripts/audio_sink_mute.sh",
    "on-scroll-up": "~/.config/scripts/audio_sink_volume_up.sh",
    "on-scroll-down": "~/.config/scripts/audio_sink_volume_down.sh",
    "return-type": "json"
  },

  "custom/brightness": {
    "exec": "~/.config/scripts/brightness_status.sh",
    "interval": 2,
    "on-scroll-up": "~/.config/scripts/brightness_up.sh",
    "on-scroll-down": "~/.config/scripts/brightness_down.sh",
    "return-type": "json"
  },

  "network": {
    "interval": 2,
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "~/.config/scripts/network_tui.sh"
  },

  "cpu": {
    "interval": 5,
    "format": "󰍛",
    "states": {
      "warning": 80,
      "critical": 90
    },
    "on-click": "~/.config/scripts/cpu_popup.sh"
  },

  "memory": {
    "interval": 5,
    "format": "󰘚"
  },

  "temperature": {
    "interval": 5,
    "critical-threshold": 80,
    "format": "󰔏",
    "format-critical": "󱃂"
  },

  "custom/layout": {
    "exec": "~/.config/scripts/layout_status.sh",
    "interval": 2,
    "on-click": "~/.config/scripts/layout_toggle.sh",
    "return-type": "json"
  },

  "custom/notification_center": {
    "exec": "~/.config/scripts/notification_center_status.sh",
    "interval": 2,
    "on-click": "~/.config/scripts/notification_center_toggle.sh",
    "return-type": "json"
  },

  "custom/logo": {
    "format": "\uf30b",
    "tooltip": true,
    "tooltip-format": "Power Options",
    "on-click": "~/.config/scripts/power_screen.sh"
  },

  "custom/expand": {
    "format": "",
    "tooltip": false
  },

  "custom/mic": {
    "exec": "~/.config/scripts/indicator_mic.sh",
    "interval": 2,
    "on-click": "~/.config/scripts/audio_source_mute.sh",
    "on-scroll-up": "~/.config/scripts/audio_source_volume_up.sh",
    "on-scroll-down": "~/.config/scripts/audio_source_volume_down.sh",
    "return-type": "json"
  },

  "custom/cam": {
    "exec": "~/.config/scripts/indicator_cam.sh",
    "interval": 3,
    "return-type": "json"
  },

  "custom/updates": {
    "exec": "~/.config/scripts/updates_check.sh",
    "interval": 900,
    "on-click": "~/.config/scripts/updates_apply.sh",
    "return-type": "json"
  },

  "custom/disks": {
    "exec": "printf '{\"text\":\"\",\"tooltip\":\"External disks\"}'",
    "interval": 3600,
    "on-click": "~/.config/scripts/disks_menu.sh",
    "return-type": "json"
  },

  "custom/bluetooth": {
    "exec": "printf '{\"text\":\"\",\"tooltip\":\"Bluetooth\"}'",
    "interval": 3600,
    "on-click": "~/.config/scripts/bluetooth_tui.sh",
    "return-type": "json"
  },

  "tray": {
    "format": "{icon}",
    "tooltip": true,
    "icon-size": 12,
    "spacing": 0
  },

  "group/expand": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 600,
      "children-class": "expand-item",
      "transition-left-to-right": false
    },
    "modules": [
      "custom/expand",
      "tray",
      "custom/bluetooth",
      "custom/disks",
      "custom/brightness",
      "memory",
      "temperature",
      "cpu"
    ]
  }
}
